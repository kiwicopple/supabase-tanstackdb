{
  "name": "@supabase/tanstack-db-collection",
  "version": "0.1.0",
  "description": "Supabase collection options creator for TanStack DB with query-driven online sync",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "supabase",
    "tanstack",
    "tanstack-db",
    "sync",
    "realtime",
    "postgrest",
    "collection"
  ],
  "author": "Supabase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/supabase/tanstack-db-collection"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/db": "^0.5.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "@tanstack/db": "^0.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
